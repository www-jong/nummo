{
  "name": "nummo",
  "version": "1.0.0",
  "description": "Minimal Numpad Practice Web Application for Left and Right Hands",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:mysql2 --external:@fastify/helmet --external:@fastify/rate-limit --external:@fastify/static --external:@fastify/cors --external:@fastify/cookie --external:fastify --external:dotenv --external:prom-client",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist/server.mjs",
    "db:init": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.12.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
